# LIVINGSTONEEDU Environment Variables Example

# Gemini AI API Key (Server-side)
GEMINI_API_KEY=

# Resend API Key for Email Notifications
RESEND_API_KEY=

# Firebase Client Configuration (if overriding default fallback)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin (if overriding default fallback credentials)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Optional Cloud SQL Configuration (PostgreSQL)
ENABLE_CLOUD_SQL=false
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_PORT=5432
